# Root-level .gitignore for monorepo

# Dependencies
node_modules
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment variables
.env
.env.local
.env.*.local
.env.production.local
.env.development.local

# Build output
dist
build
*.tsbuildinfo
.turbo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride
*.desktop

# IDE & Editor
.vscode
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Testing
coverage
.nyc_output
.mocha_output

# Docker
.docker
docker-compose.override.yml

# Misc
.cache
.next

# IDE specific
*.iml
out/
.gradle
.gradle/
